# Build inputs are opt-in. Keep this list aligned with Dockerfile COPY inputs.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!README.md
!LICENSE
!manage.py
!secondshift/
!secondshift/**
!dashboard/
!dashboard/package.json
!dashboard/package-lock.json
!dashboard/index.html
!dashboard/vite.config.ts
!dashboard/tsconfig*.json
!dashboard/src/
!dashboard/src/**
!dashboard/public/
!dashboard/public/**

# Generated/runtime files are never application source.
**/__pycache__
**/*.pyc
**/.env
**/.env.*
**/*.env
**/*.env.*
**/*.sqlite3
**/*.sqlite3-*
secondshift/**/tests
secondshift/web
