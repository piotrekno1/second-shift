# Sandboxes. Only the runner reads them, and it pulls each image when it
# starts. SECONDSHIFT_SANDBOX_<NAME> offers a sandbox called <name>, which a
# job picks with environment: <name>. Jobs that name none run in
# SECONDSHIFT_SANDBOX_DEFAULT. Add a line to offer another sandbox, or remove
# one to stop offering it. A server requires each image pinned by digest.
# Restart after a change.
SECONDSHIFT_SANDBOX_DEFAULT=python
#
# Docker's official Python image. To update, run
# `docker buildx imagetools inspect python:3.13-slim` and copy the index digest.
SECONDSHIFT_SANDBOX_PYTHON=python:3.13-slim@sha256:57b29a7c050c4e679e4bea572e14b3965cf4b5839de2da49d55e49ffc4024f39
# Python 3.13, Node 24, git and make, for jobs that run a project's full
# checks. About 1.5 GB. The tag is python3.13-nodejs24.
SECONDSHIFT_SANDBOX_PYTHON_NODE=nikolaik/python-nodejs@sha256:36165c0fb95721c983def24f998b5f4922216b4a85b639c5a4cdabdcb64d6c91
