---
const github = 'https://github.com/piotrekno1/second-shift';
const site = 'https://second-shift.app/';
const shareImage = new URL('/og.png', site).href;
const title = 'SecondShift gives the boring checks a shift';
const description = 'Put the agent skills you already use on a schedule. Open source and self-hosted.';
import demoPoster from '../assets/demo-poster.jpg';
import githubIcon from '../assets/brands/github.svg';
import sentryIcon from '../assets/brands/sentry.svg';
import anthropicIcon from '../assets/brands/anthropic.svg';
import openRouterIcon from '../assets/brands/openrouter.svg';
import discordIcon from '../assets/brands/discord.svg';
import grafanaIcon from '../assets/brands/grafana.svg';
import datadogIcon from '../assets/brands/datadog.svg';
import pagerDutyIcon from '../assets/brands/pagerduty.svg';
import wildEdgeIcon from '../assets/brands/wildedge.svg';
import openAiIcon from '../assets/brands/openai.svg';
import slackIcon from '../assets/brands/slack.svg';
import teamsIcon from '../assets/brands/microsoftteams.svg';
import fireworksIcon from '../assets/brands/fireworks.svg';
import togetherIcon from '../assets/brands/together.svg';
import basetenIcon from '../assets/brands/baseten.svg';
const stackRows = [
  { label: 'Models', href: '/docs/self-hosting/#model-providers', brands: [
    { name: 'OpenAI', icon: openAiIcon.src, color: '#ededed' },
    { name: 'Anthropic', icon: anthropicIcon.src, color: '#ededed' },
    { name: 'OpenRouter', icon: openRouterIcon.src, color: '#94a3b8' },
    { name: 'Fireworks', icon: fireworksIcon.src, color: '#9b6bff' },
    { name: 'Together AI', icon: togetherIcon.src, color: '#3d8bff' },
    { name: 'Baseten', icon: basetenIcon.src, color: '#ededed' },
  ] },
  { label: 'Tools', href: '/docs/repository-configuration/#mcp-and-api-declarations', brands: [
    { name: 'GitHub', icon: githubIcon.src, color: '#ededed' },
    { name: 'Sentry', icon: sentryIcon.src, color: '#9b83c2' },
    { name: 'Grafana', icon: grafanaIcon.src, color: '#f46800' },
    { name: 'Datadog', icon: datadogIcon.src, color: '#9d73db' },
    { name: 'PagerDuty', icon: pagerDutyIcon.src, color: '#06ac38' },
    { name: 'WildEdge', icon: wildEdgeIcon.src, color: '#00b78b', wide: true },
  ] },
  { label: 'Delivery', href: '/docs/repository-configuration/#deliver-reports-to-a-webhook', brands: [
    { name: 'Slack', icon: slackIcon.src, color: '#e01e5a' },
    { name: 'Discord', icon: discordIcon.src, color: '#5865f2' },
    { name: 'Teams', icon: teamsIcon.src, color: '#7b83eb' },
  ] },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <meta name="theme-color" content="#131313" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SecondShift" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SecondShift gives the boring checks a shift." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap');
      :root { font-family: Geist, system-ui, sans-serif; background: #131313; color: #ededed; font-synthesis: none; }
      * { box-sizing: border-box; }
      body { min-width: 320px; margin: 0; }
      a { color: inherit; text-decoration: none; }
      .shell { width: min(100% - 48px, 1280px); margin: auto; }
      header { display: flex; align-items: center; justify-content: flex-end; height: 60px; }
      nav { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; }
      nav a { display: inline-flex; align-items: center; min-height: 38px; border-radius: 6px; }
      .docs-link { padding: 0 15px; color: #ededed; }
      .docs-link:hover { background: #252525; }
      .star-link { gap: 8px; padding: 0 12px; border: 1px solid #555; background: #242424; color: #f3f3f3; }
      .star-link:hover { border-color: #ffb454; background: #303030; }
      .star-link svg { width: 16px; height: 16px; fill: none; stroke: #ffb454; stroke-width: 1.8; stroke-linejoin: round; }
      .star-count { padding-left: 8px; border-left: 1px solid #555; color: #ededed; font: 12px 'Geist Mono', ui-monospace, monospace; }
      main { padding: 0 0 56px; }
      .hero { min-height: min(720px, calc(100svh - 60px)); display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); align-items: center; gap: clamp(32px, 6vw, 90px); padding: 46px 0; }
      .hero-copy { min-width: 0; }
      .label { margin: 0 0 25px; color: #ffb454; font: 11px 'Geist Mono', ui-monospace, monospace; letter-spacing: .06em; }
      h1 { max-width: 570px; margin: 0; font-size: clamp(48px, 5vw, 76px); font-weight: 500; line-height: 1.02; letter-spacing: -.07em; }
      .hero-wordmark { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; font-size: clamp(25px, 2.4vw, 32px); font-weight: 600; letter-spacing: -.035em; }
      .hero-wordmark img { width: 34px; height: 34px; flex: none; }
      .hero-statement { display: block; }
      h1 em { color: #ffb454; font-style: normal; }
      .lead { max-width: 470px; margin: 29px 0 0; color: #b5b5b5; font-size: clamp(16px, 1.45vw, 18px); line-height: 1.6; }
      .actions { margin-top: 32px; }
      .button { display: inline-flex; align-items: center; min-height: 44px; padding: 0 17px; border-radius: 8px; background: #ededed; color: #0d0d0d; font-size: 13px; font-weight: 600; }
      .button:hover { background: #fff; }
      .stack-strip { display: flex; align-items: center; gap: 22px; min-width: 0; padding: 0 0 14px; }
      .stack-intro { flex: none; color: #ffb454; font: 11px 'Geist Mono', ui-monospace, monospace; white-space: nowrap; }
      .stack-window { height: 42px; flex: 1; min-width: 0; overflow: hidden; }
      .stack-track { animation: stack-scroll 15s linear infinite; }
      .stack-strip:hover .stack-track { animation-play-state: paused; }
      .stack-strip:focus-within .stack-window { height: auto; overflow: visible; }
      .stack-strip:focus-within .stack-track { animation: none; }
      .stack-strip:focus-within .stack-row[aria-hidden="true"] { display: none; }
      .stack-row { display: flex; align-items: center; gap: 18px; height: 42px; padding: 0 10px; border-radius: 6px; }
      .stack-row:hover { background: #202020; }
      .stack-row:focus-visible { outline: 2px solid #ffb454; outline-offset: -2px; }
      .stack-kind { width: 64px; flex: none; color: #ededed; font-size: 13px; font-weight: 600; }
      .stack-brands { display: flex; align-items: center; gap: 18px; min-width: 0; }
      .stack-brand { display: inline-flex; align-items: center; gap: 6px; color: #bdbdbd; font-size: 12px; white-space: nowrap; }
      .stack-brand-icon { width: 18px; height: 18px; flex: none; background: var(--brand-color); -webkit-mask: var(--icon-url) center / contain no-repeat; mask: var(--icon-url) center / contain no-repeat; }
      .stack-brand-icon.wide { width: 25px; }
      .stack-arrow { margin-left: auto; color: #999; font-size: 17px; }
      .stack-row:hover .stack-arrow { color: #ffb454; }
      @keyframes stack-scroll {
        0%, 20% { transform: translateY(0); }
        30%, 50% { transform: translateY(-42px); }
        60%, 80% { transform: translateY(-84px); }
        90%, 100% { transform: translateY(-126px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .stack-window { height: auto; }
        .stack-track { animation: none; }
        .stack-row[aria-hidden="true"] { display: none; }
        .first-screen { display: block; }
      }
      .showcase { min-width: 0; transform: rotate(1deg); }
      .showcase video { display: block; width: 100%; aspect-ratio: 16 / 9; border: 1px solid #373737; border-radius: 4px; background: #0d0d0d; object-fit: contain; box-shadow: 18px 20px 0 #222; }
      .example { padding: 54px 0 90px; border-top: 1px solid #303030; }
      .example-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
      .example h2 { margin: 0; font-size: clamp(26px, 3vw, 38px); font-weight: 500; letter-spacing: -.045em; }
      .example-heading a { color: #a3a3a3; font-size: 13px; white-space: nowrap; }
      .example-heading a:hover { color: #ededed; }
      .files { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .file { min-width: 0; border: 1px solid #303030; border-radius: 8px; background: #191919; }
      .file-name { display: flex; align-items: center; gap: 10px; padding: 13px 17px; border-bottom: 1px solid #303030; color: #c4c4c4; font: 12px 'Geist Mono', ui-monospace, monospace; overflow-wrap: anywhere; }
      .file-name::before { width: 7px; height: 7px; flex: none; border-radius: 50%; background: #ffb454; content: ''; }
      .file pre { margin: 0; padding: 19px 18px 23px; overflow-x: auto; color: #d0d0d0; font: 12px/1.8 'Geist Mono', ui-monospace, monospace; tab-size: 2; }
      .file .key { color: #ffb454; }
      .file .muted { color: #808080; }
      @media (min-width: 1100px) and (min-height: 760px) {
        main { padding: 0; }
        .first-screen { min-height: calc(100svh - 60px); display: grid; grid-template-rows: minmax(0, 1fr) auto auto; }
        .hero { min-height: 0; padding: 14px 0 18px; }
        .showcase { width: 100%; max-width: 600px; justify-self: end; }
        h1 { font-size: clamp(46px, 4vw, 62px); }
        .lead { margin-top: 20px; }
        .actions { margin-top: 20px; }
        .example { padding: 12px 0 32px; }
        .example-heading { margin-bottom: 9px; }
        .example h2 { font-size: 25px; }
        .file-name { padding: 7px 13px; font-size: 11px; }
        .file pre { padding: 8px 13px 9px; font-size: 11px; line-height: 1.45; }
      }
      @media (min-width: 1600px) {
        .shell { width: min(100% - 96px, 1440px); }
        .hero { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); }
        .showcase { max-width: 800px; }
        h1 { font-size: 72px; }
        .lead { max-width: 520px; font-size: 19px; }
      }
      @media (min-width: 1600px) and (min-height: 760px) {
        main { display: flex; min-height: calc(100svh - 60px); flex-direction: column; justify-content: center; padding-bottom: 60px; }
        .first-screen { min-height: 0; }
        .hero { padding: 40px 0 56px; }
        .example { padding: 24px 0 64px; }
        .example h2 { font-size: 30px; }
        .example-heading { margin-bottom: 18px; }
        .file-name { padding: 11px 16px; font-size: 12px; }
        .file pre { padding: 16px 16px 20px; font-size: 13px; line-height: 1.7; }
      }
      @media (max-width: 900px) { .hero { min-height: 0; grid-template-columns: 1fr; gap: 52px; padding: 70px 0 80px; } h1 { max-width: 760px; font-size: clamp(48px, 8vw, 72px); } .showcase { max-width: 760px; } }
      @media (max-width: 640px) { .shell { width: min(100% - 36px, 1280px); } header { height: 60px; } nav { gap: 16px; } .hero { gap: 42px; padding: 46px 0 68px; } h1 { font-size: clamp(43px, 11vw, 58px); } .hero-wordmark { margin-bottom: 16px; font-size: 25px; } .hero-wordmark img { width: 28px; height: 28px; } .lead { margin-top: 22px; font-size: 16px; } .showcase { transform: none; } .showcase video { box-shadow: 8px 9px 0 #222; } .stack-strip { gap: 8px; } .stack-row { gap: 8px; padding: 0 4px; } .stack-kind { width: 51px; font-size: 11px; } .stack-brands { gap: 12px; } .stack-brand-name { display: none; } .stack-arrow { font-size: 14px; } .example { padding: 40px 0 70px; } .example-heading { align-items: start; flex-direction: column; gap: 10px; } .files { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <div class="shell">
      <header>
        <nav><a class="docs-link" href="/docs/overview/">Docs</a><a class="star-link" href={github} target="_blank" rel="noopener noreferrer" aria-label="Star SecondShift on GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.5 2.9 6 6.6 1-4.8 4.7 1.1 6.7-5.8-3.1-5.8 3.1 1.1-6.7-4.8-4.7 6.6-1z"/></svg><span>Star</span><span class="star-count" id="star-count" hidden></span></a></nav>
      </header>
      <main>
        <div class="first-screen">
        <div class="hero">
          <div class="hero-copy">
            <h1><span class="hero-wordmark"><img src="/secondshift-mark.svg" alt="" />SecondShift</span><span class="hero-statement">gives the boring checks <em>a shift.</em></span></h1>
            <p class="lead">Put the agent skills you already use on a schedule. Let SecondShift do the work.</p>
            <div class="actions"><a class="button" href="/docs/quickstart/">Run it locally →</a></div>
          </div>
          <div class="showcase">
            <video controls playsinline preload="metadata" poster={demoPoster.src} aria-label="SecondShift product demo">
              <source src="https://github.com/user-attachments/assets/0a9a7baa-f79e-4934-af81-8e5374e9cdbf" type="video/mp4" />
              <a href="https://github.com/user-attachments/assets/0a9a7baa-f79e-4934-af81-8e5374e9cdbf">Watch the product demo</a>
            </video>
          </div>
        </div>
        <div class="stack-strip" aria-label="Services that work with SecondShift">
          <span class="stack-intro">Works with</span>
          <div class="stack-window">
            <div class="stack-track">
              {[...stackRows, stackRows[0]].map((row, index) => (
                <a class="stack-row" href={row.href} aria-hidden={index === stackRows.length ? 'true' : undefined} tabindex={index === stackRows.length ? -1 : undefined}>
                  <span class="stack-kind">{row.label}</span>
                  <span class="stack-brands">
                    {row.brands.map((brand) => (
                      <span class="stack-brand" role="img" aria-label={brand.name}>
                        <span class:list={['stack-brand-icon', { wide: brand.wide }]} style={`--brand-color: ${brand.color}; --icon-url: url(${brand.icon})`} aria-hidden="true"></span>
                        <span class="stack-brand-name">{brand.name}</span>
                      </span>
                    ))}
                  </span>
                  <span class="stack-arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>
        </div>
        <section class="example" aria-labelledby="example-title">
          <div class="example-heading">
            <h2 id="example-title">Simplest example</h2>
            <a href="/docs/repository-configuration/">How jobs work →</a>
          </div>
          <div class="files">
            <div class="file">
              <div class="file-name">.agents/skills/docs-drift/SKILL.md</div>
              <pre><code><span class="muted">---</span>
<span class="key">name:</span> docs-drift
<span class="key">description:</span> Find stale documentation.
<span class="muted">---</span>

# Documentation drift

Check docs against the repository.
Report broken links, paths, and commands.
Do not modify files.</code></pre>
            </div>
            <div class="file">
              <div class="file-name">.secondshift.yaml</div>
              <pre><code><span class="key">version:</span> 1

<span class="key">jobs:</span>
  <span class="key">docs-drift:</span>
    <span class="key">name:</span> Documentation drift
    <span class="key">skill:</span> .agents/skills/docs-drift/SKILL.md
    <span class="key">schedule:</span> "0 8 * * 1"
    <span class="key">timezone:</span> UTC</code></pre>
            </div>
          </div>
        </section>
        </div>
      </main>
    </div>
    <script>
      fetch('https://api.github.com/repos/piotrekno1/second-shift', { headers: { Accept: 'application/vnd.github+json' } })
        .then((response) => response.ok ? response.json() : null)
        .then((repo) => {
          if (typeof repo?.stargazers_count === 'number') {
            const count = document.querySelector<HTMLElement>('#star-count');
            if (count) { count.textContent = new Intl.NumberFormat().format(repo.stargazers_count); count.hidden = false; }
          }
        })
        .catch(() => {});
    </script>
  </body>
</html>
