# Local development settings. Anything not listed here has a working default.
DJANGO_ENV=dev

# Debug pages are on in development. Set to false to try production behaviour.
# DJANGO_DEBUG=false

# Where SecondShift keeps its data and generated keys.
# SECONDSHIFT_DATA_DIR=~/.secondshift

# PostgreSQL started by docker compose. Remove both lines to use SQLite.
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/secondshift

# Addresses allowed to submit forms: the dashboard and the admin.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# Where people open the dashboard. Sign-in callbacks and run links use it.
# Production needs the public HTTPS address.
FRONTEND_URL=http://localhost:5173

# Plain Docker sandboxes. Fine for your own repositories. Production uses gVisor.
SECONDSHIFT_RUNNER_RUNTIME=docker

# Optional. GitHub sign-in.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional. ChatGPT and Slack connections.
# CHATGPT_CLIENT_ID=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# Optional. Your own sandbox image. README.md lists what it needs.
# SECONDSHIFT_RUNNER_IMAGE=

# Optional. Store run files in S3 instead of the data folder.
# COMPOSE_PROFILES=s3 also starts a local S3 server with docker compose.
# COMPOSE_PROFILES=s3
# SECONDSHIFT_ARTIFACT_STORAGE=s3
# SECONDSHIFT_ARTIFACT_BUCKET=secondshift-artifacts
# SECONDSHIFT_ARTIFACT_ENDPOINT_URL=http://localhost:9000
# SECONDSHIFT_ARTIFACT_REGION=us-east-1
# SECONDSHIFT_ARTIFACT_ACCESS_KEY_ID=secondshift
# SECONDSHIFT_ARTIFACT_SECRET_ACCESS_KEY=secondshift-dev-secret
# SECONDSHIFT_ARTIFACT_ADDRESSING_STYLE=path
