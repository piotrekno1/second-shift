# Local development: copy to .env, then run process-compose up.
# Development setup and local S3: CONTRIBUTING.md#development
# Environment variable reference: docs/environment-variables.md
SECONDSHIFT_ENV=dev

# Supporting services: docker-compose.localdev.yml.
# Keep the database URL port in sync with POSTGRES_PORT.
# Remove both lines to use SQLite; process-compose still starts PostgreSQL.
POSTGRES_PORT=5433
SECONDSHIFT_DATABASE_URL=postgres://postgres:postgres@localhost:5433/secondshift

# Browser-facing origin for generated links and OAuth callbacks, not a listen address.
SECONDSHIFT_PUBLIC_URL=http://localhost:5173
# Accepted HTTP hostnames, without schemes or ports. Dev defaults to these hosts.
# SECONDSHIFT_ALLOWED_HOSTS=localhost,127.0.0.1
# Trusted browser origins, including scheme and port. Match your frontend address.
SECONDSHIFT_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
# To use a custom development hostname, update all three settings above and
# the GitHub App callback. Configure service listen addresses separately.
# Production: use the same hostname for Compose DOMAIN and generated role files.
SECONDSHIFT_RUNNER_RUNTIME=docker

# Optional development settings. Uncomment only what you need.
# Keys and the internal runner token are generated automatically in DATA_DIR.
# Model providers and job service credentials are configured in the dashboard.
# For production, use deploy/production/compose.env.example and generated role files.

# Local data and logging (changing DATA_DIR does not move existing data).
# SECONDSHIFT_DATA_DIR=/absolute/path/to/secondshift-data
# SECONDSHIFT_LOG_LEVEL=DEBUG
# DEV_ADMIN_EMAIL=admin@secondshift.local
# DEV_ADMIN_PASSWORD=replace-with-your-development-password

# GitHub App repository import. Fill all five; this is separate from sign-in.
# Callback: http://localhost:5173/github/callback/
# Registration instructions: docs/github-app.md
# SECONDSHIFT_GITHUB_APP_ID=123456
# SECONDSHIFT_GITHUB_APP_SLUG=your-secondshift-app
# SECONDSHIFT_GITHUB_APP_CLIENT_ID=Iv1.example
# SECONDSHIFT_GITHUB_APP_CLIENT_SECRET=replace-with-client-secret
# SECONDSHIFT_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Allow time for synchronous GitHub imports (seconds).
# SECONDSHIFT_HTTP_TIMEOUT_SECONDS=300

# Optional GitHub OAuth sign-in, using a separate OAuth application.
# GITHUB_CLIENT_ID=replace-with-oauth-client-id
# GITHUB_CLIENT_SECRET=replace-with-oauth-client-secret

# Email defaults to terminal output in development. Uncomment to test SMTP.
# URL-encode special characters in the SMTP username and password.
# SECONDSHIFT_EMAIL_URL=smtp+tls://user:password@mail.example.com:587
# SECONDSHIFT_FROM_EMAIL=SecondShift <noreply@example.com>

# Local S3-compatible artifacts via RustFS. Uncomment this entire block.
# These credentials are for the disposable local service, never production.
# COMPOSE_PROFILES=s3
# SECONDSHIFT_ARTIFACT_STORAGE=s3
# SECONDSHIFT_ARTIFACT_BUCKET=secondshift-artifacts
# SECONDSHIFT_ARTIFACT_ENDPOINT_URL=http://localhost:9000
# SECONDSHIFT_ARTIFACT_REGION=us-east-1
# SECONDSHIFT_ARTIFACT_ACCESS_KEY_ID=secondshift
# SECONDSHIFT_ARTIFACT_SECRET_ACCESS_KEY=secondshift-dev-secret
# SECONDSHIFT_ARTIFACT_ADDRESSING_STYLE=path

# Worker concurrency, repository polling (seconds; 0 disables it), and retention.
# SECONDSHIFT_RUN_CONCURRENCY=2
# SECONDSHIFT_REPOSITORY_SYNC_INTERVAL_SECONDS=300
# SECONDSHIFT_RUN_RETENTION_DAYS=90

# The most earlier reports a job can ask for, and their total characters (history).
# SECONDSHIFT_JOB_HISTORY_MAX=5
# SECONDSHIFT_RUN_HISTORY_MAX_CHARS=65536
