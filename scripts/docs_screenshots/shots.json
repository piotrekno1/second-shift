[
  {"name": "control/workspace-menu", "path": "/", "width": 1280, "height": 560, "clip": [0, 0, 820, 300], "animate": true,
   "steps": [{"click": ".workspace-switcher"}, "new Promise((r) => setTimeout(r, 800))",
             "document.querySelector('.workspace-menu').style.cssText += ';opacity: 1 !important; transform: none !important'"]},
  {"name": "control/new-workspace", "path": "/", "width": 1280, "height": 720, "scale": 1, "selector": ".p-dialog",
   "steps": [{"click": ".workspace-switcher"}, {"click": ".workspace-option", "text": "New workspace"},
             {"fill": ".create-workspace input", "value": "Payments team"}]},
  {"name": "control/members", "path": "/settings", "width": 1280, "height": 860, "selector": ".settings-members"},
  {"name": "control/workspace-run-limits", "path": "/settings", "width": 1280, "height": 860, "selector": "#limits"},
  {"name": "control/server-sandbox", "path": "/settings", "width": 1280, "height": 860,
   "selector": [".server-settings .panel-heading", ".server-settings .server-group"]},
  {"name": "control/runners", "path": "/settings", "width": 1600, "height": 1000, "selector": ".runners-panel"},
  {"name": "control/connections", "path": "/connections", "width": 1280, "height": 1000},
  {"name": "control/connections-awaiting-approval", "path": "/connections", "width": 1280, "height": 860, "selector": ".needs-panel"},
  {"name": "control/connection-require-approval", "path": "/connections", "width": 1280, "height": 860, "selector": "article .inset",
   "steps": [{"click": "[aria-label='More actions for Sentry']"}, {"click": "[role=menuitem] a, [role=menuitem] div", "text": "Edit"},
             "new Promise((r) => setTimeout(r, 1000))", "document.activeElement?.blur()"]},
  {"name": "control/models", "path": "/models", "width": 1280, "height": 900},
  {"name": "use/subscription-run-limit", "path": "/models", "width": 1280, "height": 900, "selector": ".services-panel",
   "steps": [{"click": "[aria-label=\"More actions for Dana's Claude Code\"]"}, {"click": "[role=menuitem] a, [role=menuitem] div", "text": "Run limit"},
             "document.activeElement?.blur()"]},
  {"name": "control/job-access-review", "path": "/jobs/1", "width": 1600, "height": 1000, "selector": "#access"},
  {"name": "control/webhook-runs-per-hour", "path": "/jobs/1", "width": 1600, "height": 1000, "selector": "#triggers"},
  {"name": "control/job-run-limits", "path": "/jobs/1", "width": 1600, "height": 1000, "selector": "#limits"},
  {"name": "use/job-page", "path": "/jobs/1", "width": 1440, "height": 900},
  {"name": "use/new-task", "path": "/repositories/1", "width": 1280, "height": 1000, "selector": ".p-dialog",
   "steps": [{"click": "button", "text": "New task"},
             {"fill": ".task-composer textarea", "value": "Find why checkout retries twice when the payment provider times out, and propose a fix."}]},
  {"name": "control/spend-overview", "path": "/", "width": 1440, "height": 1000, "selector": [".stats-grid", "#spend"],
   "steps": ["document.querySelectorAll('.stats-grid ~ *').forEach((el) => { if (el.id !== 'spend') el.style.display = 'none' })"]},
  {"name": "control/runs-by-cost", "path": "/runs?period=7d&sort=cost", "width": 1440, "height": 740, "selector": "main"},
  {"name": "control/runs-limits", "path": "/runs", "width": 1440, "height": 740},
  {"name": "control/run-budget-used-up", "path": "/runs/4", "width": 1440, "height": 860}
]
