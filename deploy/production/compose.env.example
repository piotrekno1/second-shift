# Pin an exact release version (or image digest) for all application services.
SECONDSHIFT_IMAGE=ghcr.io/piotrekno1/second-shift:0.1.0b5

DOMAIN=secondshift.example.com
# Use independent hex passwords (openssl rand -hex 32), safe in database URLs.
POSTGRES_PASSWORD=replace-with-random-hex
APP_DATABASE_PASSWORD=replace-with-different-random-hex
RUNNER_DATABASE_PASSWORD=replace-with-another-random-hex
# Absolute path on the Docker host. Create it before starting Compose.
RUNNER_ROOT=/srv/secondshift/runner

# Existing private S3 bucket. Give this key access only to that bucket.
ARTIFACT_BUCKET=secondshift-artifacts
ARTIFACT_REGION=us-east-1
ARTIFACT_ACCESS_KEY_ID=replace-me
ARTIFACT_SECRET_ACCESS_KEY=replace-me
# Use your bucket region's AWS endpoint, or your S3 provider's HTTPS endpoint.
ARTIFACT_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
ARTIFACT_ADDRESSING_STYLE=auto
