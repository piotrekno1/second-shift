# Pin an exact release version (or image digest) for all application services.
SECONDSHIFT_IMAGE=ghcr.io/piotrekno1/second-shift:0.1.0b8

DOMAIN=secondshift.example.com
# Use independent hex passwords (openssl rand -hex 32), safe in database URLs.
POSTGRES_PASSWORD=replace-with-random-hex
APP_DATABASE_PASSWORD=replace-with-different-random-hex
RUNNER_DATABASE_PASSWORD=replace-with-another-random-hex
# Absolute path on the Docker host. Create it before starting Compose.
RUNNER_ROOT=/srv/secondshift/runner

# Use s3 (default), or filesystem for a persistent local named volume.
ARTIFACT_STORAGE=s3

# Existing private S3 bucket. Give this key access only to that bucket.
ARTIFACT_BUCKET=secondshift-artifacts
ARTIFACT_REGION=us-east-1
ARTIFACT_ACCESS_KEY_ID=replace-me
ARTIFACT_SECRET_ACCESS_KEY=replace-me
# Use your bucket region's AWS endpoint, or your S3 provider's HTTPS endpoint.
ARTIFACT_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
ARTIFACT_ADDRESSING_STYLE=auto

# Optional gateway-only credential with s3:GetObject on this bucket's objects.
# Set both values together. Empty values reuse the application key above.
ARTIFACT_READ_ACCESS_KEY_ID=
ARTIFACT_READ_SECRET_ACCESS_KEY=

# Optional subscriptions. Build the separate agent image and pin its digest.
# Empty disables subscription execution; model API jobs still work.
AGENT_IMAGE=
# Dedicated bridge shared only by the gateway and transient agent containers.
# Use a unique name if running more than one installation on this Docker host.
AGENT_NETWORK=secondshift_agents
# Reserved for the dedicated agent bridge; adjust both if they overlap a host route.
AGENT_SUBNET=172.30.0.0/24
AGENT_GATEWAY_ADDRESS=172.30.0.2
