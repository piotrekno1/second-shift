# The same release as the control plane, pinned by version or digest.
SECONDSHIFT_IMAGE=ghcr.io/piotrekno1/second-shift:0.1.0b17

# This runner's public hostname. Caddy gets its certificate, and the control
# plane registers it as https://RUNNER_DOMAIN.
RUNNER_DOMAIN=runner-b.example.com
# A random hex password (openssl rand -hex 32), safe in a database URL.
RUNNER_DATABASE_PASSWORD=replace-with-random-hex
# Absolute path on the Docker host. Create it before starting Compose.
RUNNER_ROOT=/srv/secondshift/runner

# Optional subscriptions. Build the agent image on this host and pin its digest.
AGENT_IMAGE=
# Internal bridge for agent containers. Agents reach the internet and the
# runner's relay only through the egress proxy at AGENT_PROXY_ADDRESS.
AGENT_NETWORK=secondshift_runner_agents
AGENT_SUBNET=172.30.0.0/24
AGENT_PROXY_ADDRESS=172.30.0.3
# The proxy's port that passes agents' tool calls through to the runner.
RELAY_FORWARD_PORT=8001

# Optional setup commands. To turn them on, uncomment both lines.
# COMPOSE_PROFILES=setup
# SETUP_PROXY_ADDRESS=172.31.0.3
SETUP_NETWORK=secondshift_runner_setup
SETUP_SUBNET=172.31.0.0/24
